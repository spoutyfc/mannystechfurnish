# Copy to .env.local (or .env for Docker) and fill in. Never commit real values.

# --- Database (Neon Postgres) ---
DATABASE_URL=

# --- Auth ---
# Signs the admin session cookie (HMAC-SHA256). Long random string.
ADMIN_SESSION_SECRET=
# Better Auth secret and public base URL.
BETTER_AUTH_SECRET=
# Enables POST /api/admin-setup to bootstrap the first admin. Leave empty to disable it.
ADMIN_SETUP_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
# Optional: Stripe Connect access token, preferred over STRIPE_SECRET_KEY when set.
STRIPE_ACCESS_TOKEN=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# --- Bot protection (Cloudflare Turnstile) ---
# Required in any production build or Vercel deploy: without TURNSTILE_SECRET_KEY the
# contact form refuses submissions with a 503. For a local `next start` only, set
# ALLOW_UNVERIFIED_CONTACT=1 to skip the check. Never set it in a deployed environment.
ALLOW_UNVERIFIED_CONTACT=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting (Upstash Redis / Vercel KV); either pair works ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Public base URL used for Stripe success/cancel redirects ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Self-hosted only (ignored on Vercel): number of reverse proxies in front of the app.
# Rate limits read the client IP from that many x-forwarded-for entries from the right.
# Unset means headers are not trusted and all clients share one rate-limit bucket.
TRUSTED_PROXY_HOPS=
